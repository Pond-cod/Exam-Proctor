{
  "manifest_version": 3,
  "name": "Exam Proctor Lock v2.1",
  "version": "2.1",
  "description": "ระบบคุมสอบ Google Forms พร้อมหน้าตั้งค่า URL และระบบ Admin Monitor",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.gle/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://examproctor-jade.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://forms.gle/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}